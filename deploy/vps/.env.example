# ==============================================================================
# Physio One WhatsApp AI Platform — Hostinger VPS Environment Configuration
# Copy this file to .env on the Hostinger VPS: cp .env.example .env
# Secure file permissions immediately: chmod 600 .env
# NEVER commit the filled .env file to Git!
# ==============================================================================

# --- Domain & Ingress Routing ---
# Set to your clinic's public domain (e.g., clinic.physioone.in or app.yourdomain.com)
DOMAIN_NAME=app.example.com
NEXT_PUBLIC_API_URL=https://app.example.com

# --- Environment Setting ---
# Options: staging | production
ENVIRONMENT=staging

# --- Database Credentials (PostgreSQL 16 + pgvector) ---
POSTGRES_USER=physio_admin
POSTGRES_PASSWORD=generate_high_entropy_db_password_here_min_32_chars
POSTGRES_DB=physio_one_db

# --- Security Master Keys ---
# Generate using: openssl rand -hex 32
APP_SECRET=generate_high_entropy_app_secret_here_min_32_chars
JWT_SECRET_KEY=generate_high_entropy_jwt_secret_here_min_32_chars

# --- Internal Automation Worker Secret ---
# Generate using: openssl rand -hex 24 (min 16 chars)
AUTOMATION_WORKER_SECRET_TOKEN=generate_worker_secret_token_here_min_24_chars

# --- Staging Safety Controls (Mandatory Defaults) ---
# When ENVIRONMENT=staging, these prevent unintended messaging and data mutations:
STAGING_MOCK_OUTBOUND=true
AUTOMATION_OUTBOUND_ENABLED=false
DEFAULT_AI_INBOUND_MODE=disabled
APPOINTMENTS_READ_ONLY=true
CAMPAIGNS_DRAFT_ONLY=true
# Test allowlist: only phone numbers in E.164 format listed here receive messages if mock is off
STAGING_ALLOWLIST_PHONE_NUMBERS=[]

# --- Worker Polling Interval ---
WORKER_POLL_INTERVAL_SECONDS=15

# --- WhatsApp Provider Credentials (Optional in Staging Mock Mode) ---
# Meta Cloud API
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_APP_SECRET=
META_WHATSAPP_VERIFY_TOKEN=

# YCloud API (Optional)
YCLOUD_API_KEY=
YCLOUD_WEBHOOK_SECRET=

# --- External AI Gateway API Keys (Optional in Staging Mock Mode) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Backup Configuration ---
BACKUP_DIR=/opt/physio/backups
BACKUP_RETENTION_DAYS=7
