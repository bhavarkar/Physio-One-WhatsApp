# ==============================================================================
# WHATSAPP AI AGENT — SINGLE ORGANIZATION EDITION (.env.example)
# Reference Deployment: Physio One Clinic
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT & VERSION
# ------------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_NAME="Physio One WhatsApp AI Agent"
APP_SECRET=change-this-to-a-secure-random-64-char-string
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
HOST=0.0.0.0
PORT=8000

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL + pgvector)
# ------------------------------------------------------------------------------
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=physio_admin
POSTGRES_PASSWORD=physio_secure_password
POSTGRES_DB=physio_one_db
DATABASE_URL=postgresql+asyncpg://physio_admin:physio_secure_password@localhost:5432/physio_one_db

# ------------------------------------------------------------------------------
# 3. REDIS & CELERY CONFIGURATION
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ------------------------------------------------------------------------------
# 4. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
JWT_SECRET_KEY=change-this-jwt-secret-to-a-very-secure-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
COOKIE_SECURE=false

# ------------------------------------------------------------------------------
# 5. WHATSAPP CLOUD API CONFIGURATION (Physio One Account)
# ------------------------------------------------------------------------------
WHATSAPP_PROVIDER=meta_cloud_api
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id
WHATSAPP_WABA_ID=your_whatsapp_business_account_id
WHATSAPP_ACCESS_TOKEN=your_meta_system_user_permanent_token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_custom_webhook_verification_token
WHATSAPP_APP_SECRET=your_meta_app_secret

# ------------------------------------------------------------------------------
# 6. LLM GATEWAY CONFIGURATION
# ------------------------------------------------------------------------------
DEFAULT_LLM_PROVIDER=muse
MUSE_API_KEY=your_muse_api_key_here
MUSE_API_BASE_URL=https://api.muse.example.com/v1
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GENERIC_OPENAI_API_KEY=
GENERIC_OPENAI_BASE_URL=http://localhost:8080/v1

# ------------------------------------------------------------------------------
# 7. CLINIC OPERATIONAL RULES (Physio One Defaults)
# ------------------------------------------------------------------------------
CLINIC_NAME="Physio One"
CLINIC_TIMEZONE="Asia/Kolkata"
CLINIC_OPEN_TIME="09:00"
CLINIC_CLOSE_TIME="20:00"
# Closed on Sundays (0 = Sunday in python/postgres extraction)
CLINIC_CLOSED_WEEKDAYS=[0]
DEFAULT_APPOINTMENT_DURATION_MINUTES=45
FOLLOWUP_TOUCH1_INACTIVITY_HOURS=2
FOLLOWUP_TOUCH2_INTERVAL_HOURS=24
FOLLOWUP_TOUCH3_INTERVAL_HOURS=48
CAMPAIGN_WINDOW_START_HOUR=9
CAMPAIGN_WINDOW_END_HOUR=21

# ------------------------------------------------------------------------------
# 8. STORAGE CONFIGURATION (Media & Audio)
# ------------------------------------------------------------------------------
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage
S3_BUCKET_NAME=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ------------------------------------------------------------------------------
# 9. EMBEDDINGS & KNOWLEDGE BASE (pgvector RAG)
# ------------------------------------------------------------------------------
EMBEDDING_PROVIDER=deterministic
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
KNOWLEDGE_STORAGE_PATH=./storage/knowledge

# ------------------------------------------------------------------------------
# 10. AI INBOUND ORCHESTRATION & DEBOUNCE (Task 9)
# ------------------------------------------------------------------------------
DEFAULT_AI_INBOUND_MODE=disabled
INBOUND_DEBOUNCE_SECONDS=5
INBOUND_MAX_AI_STEPS=5
INBOUND_PROCESSING_TIMEOUT_SECONDS=60

# ------------------------------------------------------------------------------
# 11. SCHEDULED AUTOMATION & FOLLOW-UPS (Task 11)
# ------------------------------------------------------------------------------
# Global kill switch for scheduled automation dispatches. Mandatory default: false.
AUTOMATION_OUTBOUND_ENABLED=false
AUTOMATION_WORKER_INTERVAL_SECONDS=60
AUTOMATION_WORKER_SECRET_TOKEN=default-automation-worker-secret-token

# ------------------------------------------------------------------------------
# 12. CLOUD RUN & WORKER OIDC AUTHENTICATION (Task 13)
# ------------------------------------------------------------------------------
CLOUD_RUN_SERVICE_URL=https://physio-one-api-xyz-uc.a.run.app
WORKER_SERVICE_ACCOUNT_EMAIL=physio-one-worker@physio-one-prod.iam.gserviceaccount.com
OIDC_AUDIENCE=https://physio-one-api-xyz-uc.a.run.app
REQUIRE_OIDC_IN_PRODUCTION=false
WORKER_POLL_INTERVAL_SECONDS=15




